<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Усі видимі користувачеві рядки — тут. У коді й розмітці не має бути літералів
        українською: беремо через {StaticResource Str_...}.
        Кольори тут не задаються — вони живуть у Themes/.
    -->

    <sys:String x:Key="Str_AppTitle">ReadFlow</sys:String>

    <!-- Ліва панель налаштувань -->
    <sys:String x:Key="Str_SettingsHeader">Налаштування</sys:String>
    <sys:String x:Key="Str_CollapsePanel">Згорнути панель налаштувань</sys:String>
    <sys:String x:Key="Str_ExpandPanel">Розгорнути панель налаштувань</sys:String>

    <sys:String x:Key="Str_ThemeLabel">Тема</sys:String>
    <sys:String x:Key="Str_FontSizeLabel">Розмір шрифту</sys:String>
    <sys:String x:Key="Str_LineHeightLabel">Міжрядковий інтервал</sys:String>
    <sys:String x:Key="Str_UseThemeSizes">Як у темі</sys:String>

    <sys:String x:Key="Str_ParagraphModeLabel">Абзаци рахувати як</sys:String>
    <sys:String x:Key="Str_ParagraphModeLines">Кожен непорожній рядок</sys:String>
    <sys:String x:Key="Str_ParagraphModeBlocks">Блок між порожніми рядками</sys:String>

    <sys:String x:Key="Str_TimerLabel">Тривалість заміру, с</sys:String>

    <sys:String x:Key="Str_MeasurementModeLabel">Спосіб заміру</sys:String>
    <sys:String x:Key="Str_ModeClickStop">Клік = стоп</sys:String>
    <sys:String x:Key="Str_ModeTimer">Таймер + ручний стоп</sys:String>
    <sys:String x:Key="Str_MarkErrors">Відмічати помилки</sys:String>

    <!-- Центральна зона тексту -->
    <sys:String x:Key="Str_TextPlaceholder">Вставте текст сюди</sys:String>
    <sys:String x:Key="Str_ReadingMode">Режим читання</sys:String>
    <sys:String x:Key="Str_WordNumberFormat">Слово №{0}</sys:String>

    <!-- Нижня панель статистики -->
    <sys:String x:Key="Str_StatWords">Слова</sys:String>
    <sys:String x:Key="Str_StatChars">Знаки</sys:String>
    <sys:String x:Key="Str_StatCharsNoSpaces">Знаки без пробілів</sys:String>
    <sys:String x:Key="Str_StatLetters">Букви</sys:String>
    <sys:String x:Key="Str_StatAverageWordLength">Сер. довжина слова</sys:String>
    <sys:String x:Key="Str_StatSentences">Речення</sys:String>
    <sys:String x:Key="Str_StatParagraphs">Абзаци</sys:String>

    <!-- Керування таймером (Задача 6) -->
    <sys:String x:Key="Str_ControlsPlaceholder">Тут буде керування таймером: Старт, Стоп, Скидання.</sys:String>

</ResourceDictionary>
