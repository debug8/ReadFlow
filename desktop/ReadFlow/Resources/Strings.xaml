<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Усі видимі користувачеві рядки — тут. У коді й розмітці не має бути літералів
        українською: беремо через {StaticResource Str_...}.
        Кольори тут не задаються — вони живуть у Themes/.
    -->

    <sys:String x:Key="Str_AppTitle">ReadFlow</sys:String>

    <!-- Меню -->
    <sys:String x:Key="Str_MenuHelp">Довідка</sys:String>
    <sys:String x:Key="Str_MenuAbout">Про програму</sys:String>

    <!-- Вікно «Про програму» -->
    <sys:String x:Key="Str_AboutTitle">Про програму</sys:String>
    <sys:String x:Key="Str_AboutVersionFormat">Версія {0}</sys:String>
    <sys:String x:Key="Str_AboutTagline">Підрахунок слів у тексті й перевірка швидкості читання учнів.</sys:String>
    <sys:String x:Key="Str_AboutDescription">Вставте текст — застосунок одразу порахує слова, знаки, букви, речення й абзаци.&#x0a;&#x0a;Щоб перевірити швидкість читання, увімкніть «Режим читання» над текстом і клікніть слово, на якому учень зупинився. Пробіл запускає й зупиняє замір, Esc скидає його.&#x0a;&#x0a;Дані нікуди не надсилаються: застосунок працює без мережі й без облікових записів.</sys:String>
    <sys:String x:Key="Str_AboutClose">Закрити</sys:String>

    <!-- Ліва панель налаштувань -->
    <sys:String x:Key="Str_SettingsHeader">Налаштування</sys:String>
    <sys:String x:Key="Str_CollapsePanel">Згорнути панель налаштувань</sys:String>
    <sys:String x:Key="Str_ExpandPanel">Розгорнути панель налаштувань</sys:String>

    <sys:String x:Key="Str_ThemeLabel">Тема</sys:String>
    <sys:String x:Key="Str_FontSizeLabel">Розмір шрифту</sys:String>
    <sys:String x:Key="Str_LineHeightLabel">Міжрядковий інтервал</sys:String>
    <sys:String x:Key="Str_UseThemeSizes">Як у темі</sys:String>

    <sys:String x:Key="Str_ReadingFont">Шрифт, зручний для читання</sys:String>
    <sys:String x:Key="Str_ReadingFontHint">Ширші літери й більші проміжки між ними. Розмір і міжрядковий інтервал лишаються за повзунками вище.</sys:String>
    <sys:String x:Key="Str_LineHighlight">Підсвічувати рядок</sys:String>
    <sys:String x:Key="Str_LineHighlightHint">У режимі читання підсвічує рядок, над яким курсор, — щоб не губити місце.</sys:String>

    <sys:String x:Key="Str_ParagraphModeLabel">Абзаци рахувати як</sys:String>
    <sys:String x:Key="Str_ParagraphModeLines">Кожен непорожній рядок</sys:String>
    <sys:String x:Key="Str_ParagraphModeBlocks">Блок між порожніми рядками</sys:String>

    <sys:String x:Key="Str_TimerLabel">Тривалість заміру, с</sys:String>

    <sys:String x:Key="Str_MeasurementModeLabel">Спосіб заміру</sys:String>
    <sys:String x:Key="Str_ModeClickStop">Клік = стоп</sys:String>
    <sys:String x:Key="Str_ModeTimer">Таймер + ручний стоп</sys:String>
    <sys:String x:Key="Str_MarkErrors">Відмічати помилки</sys:String>

    <!-- Центральна зона тексту -->
    <sys:String x:Key="Str_TextPlaceholder">Вставте текст сюди</sys:String>
    <sys:String x:Key="Str_ReadingMode">Режим читання</sys:String>
    <sys:String x:Key="Str_WordNumberFormat">Слово №{0}</sys:String>

    <!-- Нижня панель статистики -->
    <sys:String x:Key="Str_StatWords">Слова</sys:String>
    <sys:String x:Key="Str_StatChars">Знаки</sys:String>
    <sys:String x:Key="Str_StatCharsNoSpaces">Знаки без пробілів</sys:String>
    <sys:String x:Key="Str_StatLetters">Букви</sys:String>
    <sys:String x:Key="Str_StatAverageWordLength">Сер. довжина слова</sys:String>
    <sys:String x:Key="Str_StatSentences">Речення</sys:String>
    <sys:String x:Key="Str_StatParagraphs">Абзаци</sys:String>

    <!-- Керування таймером -->
    <sys:String x:Key="Str_TimerStart">Старт</sys:String>
    <sys:String x:Key="Str_TimerStop">Стоп</sys:String>
    <sys:String x:Key="Str_TimerReset">Скидання</sys:String>
    <sys:String x:Key="Str_HotkeyHint">Пробіл — старт і стоп, Esc — скидання. У режимі читання: клік по слову — межа читання; коли ввімкнено «Відмічати помилки» — лівий клік позначає помилку, правий ставить межу.</sys:String>

    <!-- Підсумок заміру -->
    <sys:String x:Key="Str_ResultWordsRead">Прочитано слів</sys:String>
    <sys:String x:Key="Str_ResultErrors">Помилки</sys:String>
    <sys:String x:Key="Str_ResultErrorPercent">Помилок від прочитаного</sys:String>
    <sys:String x:Key="Str_ResultCleanWpm">Чиста швидкість</sys:String>
    <sys:String x:Key="Str_ResultTime">Час читання</sys:String>
    <sys:String x:Key="Str_ResultWpm">Слів за хвилину</sys:String>
    <sys:String x:Key="Str_ResultCpm">Знаків за хвилину</sys:String>

</ResourceDictionary>
