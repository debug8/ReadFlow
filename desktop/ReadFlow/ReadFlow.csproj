    <!-- None, а не Resource: файл потрібен збірці як ApplicationIcon і вже
         вшивається в .exe. Другий раз як ресурс він там ні до чого. -->
    <None Include="Resources\ReadFlow.ico" />
    <!-- Сигнал завершення заданої тривалості. Resource, а не Content:
         звук має лежати всередині .exe, а не поруч із ним. -->
    <Resource Include="Resources\timer-end.wav" />
    <!-- Норми техніки читання. Лінк на shared/norms.json, а не копія: копія
         рано чи пізно розійшлася б із Android-версією, яка читає той самий файл.
         Resource — щоб норми були всередині .exe й застосунок працював без
         жодного файлу поруч. Учитель усе одно може покласти свій norms.json
         біля .exe: NormsLoader читає спершу його. -->
    <Resource Include="..\..\shared\norms.json">
      <Link>Resources\norms.json</Link>
    </Resource>
    <!-- Тексти-зразки. Маска, а не перелік: додати текст = покласти файл
         у shared/samples/ і дописати рядок в index.json, csproj не чіпати.
         Після додавання файлу проєкт треба перезавантажити у Visual Studio —
         маски обчислюються під час завантаження. -->
    <Resource Include="..\..\shared\samples\index.json">
      <Link>Resources\samples\index.json</Link>
    </Resource>
    <Resource Include="..\..\shared\samples\*.txt">
      <Link>Resources\samples\%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>
