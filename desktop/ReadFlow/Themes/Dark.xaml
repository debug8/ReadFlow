<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Темна тема. Набір ключів мусить збігатися з Light.xaml. -->

    <sys:String x:Key="ThemeDisplayName">Темна</sys:String>

    <!-- Тло й текст -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1E2227" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF262B31" />
    <SolidColorBrush x:Key="TextBackgroundBrush" Color="#FF15181C" />
    <SolidColorBrush x:Key="TextForegroundBrush" Color="#FFE6E9ED" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FF9AA4AF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4C93E0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3A424B" />

    <!-- Слова: підсвітка під курсором, межа читання (режим A), помилка (режим C) -->
    <SolidColorBrush x:Key="WordHoverBrush" Color="#FF2E3A47" />
    <SolidColorBrush x:Key="WordBoundaryBrush" Color="#FF6B5320" />
    <SolidColorBrush x:Key="WordErrorBrush" Color="#FF6E2F2F" />

    <!-- Підсвітка рядка під курсором у режимі читання (Задача 9).
         Помітно блідіша за WordHoverBrush: смуга на всю ширину тим самим
         кольором сховала б слово під курсором. -->
    <SolidColorBrush x:Key="LineHighlightBrush" Color="#FF23282E" />

    <!-- Оцінка результату відносно норми -->
    <SolidColorBrush x:Key="NormBelowBrush" Color="#FFE57373" />
    <SolidColorBrush x:Key="NormWithinBrush" Color="#FF81C784" />
    <SolidColorBrush x:Key="NormAboveBrush" Color="#FF64B5F6" />

    <!-- Пункти випадних списків. Обраний пункт — насиченіше тло, а не інший
         колір тексту: у високому контрасті акцент чистий cyan, і білий текст
         на ньому не читався б. -->
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF2E3A47" />
    <SolidColorBrush x:Key="ControlSelectedBrush" Color="#FF3E5068" />

    <!-- Таймер під час активного заміру -->
    <SolidColorBrush x:Key="TimerActiveBrush" Color="#FF81C784" />

    <!-- Типографіка -->
    <sys:Double x:Key="BaseFontSize">16</sys:Double>
    <sys:Double x:Key="TextLineHeight">26</sys:Double>

</ResourceDictionary>
