<Window x:Class="ReadFlow.Views.NormsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Str_NormsTitle}"
        Width="520"
        SizeToContent="Height"
        MaxHeight="720"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        xml:lang="uk-UA"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}">

    <!--
        Таблиця складена зі StackPanel і Grid, а не з DataGrid. DataGrid тягне
        власний набір системних кольорів — заголовки, лінії, виділення рядка —
        і в темній темі довелося б переписувати ще й його шаблон заради таблиці
        на чотири рядки.

        Колонки тримаються в одну лінію через SharedSizeGroup: підпис класу
        приходить із norms.json і може бути будь-якої довжини, тож фіксована
        ширина рано чи пізно обрізала б його.
    -->

    <Window.Resources>
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        </Style>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20" Grid.IsSharedSizeScope="True">
        <TextBlock Text="{StaticResource Str_NormsTitle}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextForegroundBrush}" />

        <TextBlock Text="{StaticResource Str_NormsUnit}"
                   Margin="0,2,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryForegroundBrush}" />

        <!-- Таблиця норм -->
        <StackPanel x:Name="TableSection" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GradeColumn" MinWidth="120" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FirstColumn" MinWidth="120" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SecondColumn" MinWidth="120" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource HeaderCellStyle}"
                           Text="{StaticResource Str_NormsColumnGrade}" />
                <TextBlock Grid.Column="1" Style="{StaticResource HeaderCellStyle}"
                           Text="{StaticResource Str_SemesterFirst}" />
                <TextBlock Grid.Column="2" Style="{StaticResource HeaderCellStyle}"
                           Text="{StaticResource Str_SemesterSecond}" />
            </Grid>

            <Border BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" />

            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GradeColumn" MinWidth="120" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FirstColumn" MinWidth="120" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SecondColumn" MinWidth="120" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource CellStyle}"
                                       Text="{Binding GradeLabel}" />

                            <!-- Клітинка норми, за якою оцінюється поточний замір,
                                 підсвічується тлом, а не іншим кольором тексту:
                                 у високому контрасті колірне кодування тексту
                                 читається гірше за тло. -->
                            <Border Grid.Column="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirstActive}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource ControlSelectedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FirstText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirstActive}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Border Grid.Column="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSecondActive}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource ControlSelectedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SecondText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSecondActive}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" />

            <TextBlock x:Name="ActiveHint"
                       Text="{StaticResource Str_NormsActiveHint}"
                       Margin="10,10,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" />
        </StackPanel>

        <!-- Показується замість таблиці, коли довідник не прочитався. -->
        <TextBlock x:Name="EmptyMessage"
                   Text="{StaticResource Str_NormsEmpty}"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource TextForegroundBrush}" />

        <!-- Джерело й застереження — з norms.json, не з коду. -->
        <TextBlock x:Name="SourceText"
                   Margin="0,16,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource SecondaryForegroundBrush}" />

        <TextBlock x:Name="NoteText"
                   Margin="0,6,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource SecondaryForegroundBrush}" />

        <TextBlock Text="{StaticResource Str_NormsFileHint}"
                   Margin="0,14,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryForegroundBrush}" />

        <!-- TextBox, а не TextBlock: шлях зазвичай потрібно скопіювати,
             а IsReadOnly лишає його недоторканним. -->
        <TextBox x:Name="PathText"
                 Margin="0,4,0,0"
                 Padding="6,4"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 Background="{DynamicResource TextBackgroundBrush}"
                 Foreground="{DynamicResource SecondaryForegroundBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" />

        <Button Content="{StaticResource Str_Close}"
                IsCancel="True"
                IsDefault="True"
                Click="OnCloseClick"
                Margin="0,18,0,0"
                MinWidth="96" Height="30"
                HorizontalAlignment="Right" />
    </StackPanel>
</Window>
