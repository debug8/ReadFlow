<Window x:Class="ReadFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReadFlow.ViewModels"
        xmlns:views="clr-namespace:ReadFlow.Views"
        xmlns:core="clr-namespace:ReadFlow.Core"
        Title="{StaticResource Str_AppTitle}"
        Height="700" Width="1100"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        xml:lang="uk-UA"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <!--
        xml:lang="uk-UA" — не косметика: привʼязки WPF форматують числа за Language
        елемента, а не за культурою системи, і за замовчуванням це en-US.
        Без цього рядка вчитель бачив би «3.7» і «3,000» замість «3,7» і «3 000».
    -->

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Стилі показників статистики: щоб не повторювати оформлення сім разів. -->
        <Style x:Key="StatBlockStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="112" />
            <Setter Property="Margin" Value="0,0,12,6" />
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        </Style>
        <Style x:Key="StatCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        </Style>

        <!-- Підпис над елементом налаштування -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        </Style>
        <Style x:Key="SettingComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource TextBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style x:Key="SettingCheckStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        </Style>
        <Style x:Key="SettingRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        </Style>
        <Style x:Key="TimerPresetStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Command" Value="{Binding SetTimerSecondsCommand}" />
        </Style>
    </Window.Resources>

    <!--
        Три зони: ліва панель налаштувань (вузька колонка, на всю висоту),
        центр — текст, низ — статистика й керування.
        Кольори — тільки через DynamicResource; ключі визначені в Themes/.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ЗОНА 1: панель налаштувань. Згортається до вузької смужки з кнопкою. -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="240" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="False">
                            <Setter Property="Width" Value="40" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <!-- Шапка з кнопкою згортання. Кнопка видима завжди, інакше
                     згорнуту панель не було б чим повернути. -->
                <Grid DockPanel.Dock="Top" Margin="8,10,8,0">
                    <TextBlock Text="{StaticResource Str_SettingsHeader}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForegroundBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding ToggleSettingsCommand}"
                            HorizontalAlignment="Right"
                            Width="24" Height="24"
                            Padding="0"
                            Foreground="{DynamicResource TextForegroundBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="&#x2039;" />
                                <Setter Property="ToolTip" Value="{StaticResource Str_CollapsePanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="False">
                                        <Setter Property="Content" Value="&#x203A;" />
                                        <Setter Property="ToolTip" Value="{StaticResource Str_ExpandPanel}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel Margin="16,0,16,16">
                        <!-- Тема. Список береться з файлів у Themes/ — нова тема зʼявляється сама. -->
                        <TextBlock Text="{StaticResource Str_ThemeLabel}"
                                   Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource SettingComboStyle}" />

                        <!-- Розмір шрифту -->
                        <TextBlock Style="{StaticResource SettingLabelStyle}">
                            <Run Text="{StaticResource Str_FontSizeLabel}" />
                            <Run Text="{Binding FontSize, StringFormat={}{0:N0}}" />
                        </TextBlock>
                        <Slider Value="{Binding FontSize}"
                                Minimum="10" Maximum="40"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Foreground="{DynamicResource AccentBrush}" />

                        <!-- Міжрядковий інтервал -->
                        <TextBlock Style="{StaticResource SettingLabelStyle}">
                            <Run Text="{StaticResource Str_LineHeightLabel}" />
                            <Run Text="{Binding LineHeight, StringFormat={}{0:N0}}" />
                        </TextBlock>
                        <Slider Value="{Binding LineHeight}"
                                Minimum="12" Maximum="60"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Foreground="{DynamicResource AccentBrush}" />

                        <Button Content="{StaticResource Str_UseThemeSizes}"
                                Command="{Binding UseThemeSizesCommand}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Padding="10,2" />

                        <!-- Тривалість заміру -->
                        <TextBlock Text="{StaticResource Str_TimerLabel}"
                                   Style="{StaticResource SettingLabelStyle}" />
                        <TextBox Text="{Binding TimerSeconds, UpdateSourceTrigger=LostFocus}"
                                 Background="{DynamicResource TextBackgroundBrush}"
                                 Foreground="{DynamicResource TextForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 CaretBrush="{DynamicResource TextForegroundBrush}"
                                 Padding="4,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="30" CommandParameter="30" Style="{StaticResource TimerPresetStyle}" />
                            <Button Content="60" CommandParameter="60" Style="{StaticResource TimerPresetStyle}" />
                            <Button Content="120" CommandParameter="120" Style="{StaticResource TimerPresetStyle}" />
                        </StackPanel>

                        <!-- Режим підрахунку абзаців (специфікація, 4.6) -->
                        <TextBlock Text="{StaticResource Str_ParagraphModeLabel}"
                                   Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox SelectedValue="{Binding ParagraphMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource SettingComboStyle}">
                            <ComboBoxItem Content="{StaticResource Str_ParagraphModeLines}"
                                          Tag="{x:Static core:ParagraphMode.NonEmptyLines}" />
                            <ComboBoxItem Content="{StaticResource Str_ParagraphModeBlocks}"
                                          Tag="{x:Static core:ParagraphMode.BlankLineSeparated}" />
                        </ComboBox>

                        <!-- Спосіб заміру. A і B — взаємовиключні, C накладається на будь-який. -->
                        <TextBlock Text="{StaticResource Str_MeasurementModeLabel}"
                                   Style="{StaticResource SettingLabelStyle}" />
                        <RadioButton Content="{StaticResource Str_ModeClickStop}"
                                     GroupName="MeasurementMode"
                                     IsChecked="{Binding IsClickStopMode}"
                                     Style="{StaticResource SettingRadioStyle}" />
                        <RadioButton Content="{StaticResource Str_ModeTimer}"
                                     GroupName="MeasurementMode"
                                     IsChecked="{Binding IsTimerMode}"
                                     Style="{StaticResource SettingRadioStyle}" />
                        <CheckBox Content="{StaticResource Str_MarkErrors}"
                                  IsChecked="{Binding MarkErrors}"
                                  Margin="0,12,0,0"
                                  Style="{StaticResource SettingCheckStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ЗОНА 2: текст -->
        <Border Grid.Column="1" Grid.Row="0"
                Margin="16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource TextBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0"
                          Content="{StaticResource Str_ReadingMode}"
                          IsChecked="{Binding IsReadingMode}"
                          Margin="12,10,12,0"
                          HorizontalAlignment="Right"
                          Foreground="{DynamicResource SecondaryForegroundBrush}" />

                <!-- Режим редагування -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadingMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <TextBox x:Name="TextInput"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Padding="12"
                             BorderThickness="0"
                             Background="{DynamicResource TextBackgroundBrush}"
                             Foreground="{DynamicResource TextForegroundBrush}"
                             CaretBrush="{DynamicResource TextForegroundBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             FontSize="{DynamicResource BaseFontSize}" />

                    <!-- Підказка поверх порожнього поля. IsHitTestVisible=False — щоб не
                         перехоплювала клік і курсор ставився в поле. -->
                    <TextBlock Text="{StaticResource Str_TextPlaceholder}"
                               Margin="14,13,0,0"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Режим читання. Схований контрол не будує Runʼи — див. WordReaderView. -->
                <views:WordReaderView Grid.Row="1"
                                      Document="{Binding Document}">
                    <views:WordReaderView.Style>
                        <Style TargetType="views:WordReaderView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadingMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:WordReaderView.Style>
                </views:WordReaderView>
            </Grid>
        </Border>

        <!-- ЗОНА 3: статистика й керування -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="16,12,16,12">
                <WrapPanel>
                    <StackPanel Style="{StaticResource StatBlockStyle}">
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding Stats.WordCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatCaptionStyle}"
                                   Text="{StaticResource Str_StatWords}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource StatBlockStyle}">
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding Stats.CharCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatCaptionStyle}"
                                   Text="{StaticResource Str_StatChars}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource StatBlockStyle}">
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding Stats.CharCountNoSpaces, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatCaptionStyle}"
                                   Text="{StaticResource Str_StatCharsNoSpaces}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource StatBlockStyle}">
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding Stats.LetterCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatCaptionStyle}"
                                   Text="{StaticResource Str_StatLetters}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource StatBlockStyle}">
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding Stats.AverageWordLength, StringFormat={}{0:N1}}" />
                        <TextBlock Style="{StaticResource StatCaptionStyle}"
                                   Text="{StaticResource Str_StatAverageWordLength}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource StatBlockStyle}">
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding Stats.SentenceCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatCaptionStyle}"
                                   Text="{StaticResource Str_StatSentences}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource StatBlockStyle}">
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding Stats.ParagraphCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatCaptionStyle}"
                                   Text="{StaticResource Str_StatParagraphs}" />
                    </StackPanel>
                </WrapPanel>

                <!-- Керування заміром і підсумок -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding ElapsedDisplay}"
                               FontSize="30" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               MinWidth="94">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeasuring}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TimerActiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding ToggleMeasurementCommand}"
                            MinWidth="86" Height="32"
                            Margin="12,0,8,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="{StaticResource Str_TimerStart}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeasuring}" Value="True">
                                        <Setter Property="Content" Value="{StaticResource Str_TimerStop}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{StaticResource Str_TimerReset}"
                            Command="{Binding ResetMeasurementCommand}"
                            MinWidth="86" Height="32"
                            VerticalAlignment="Center" />

                    <!-- Підсумок зʼявляється лише після завершеного заміру,
                         щоб порожні нулі не збивали з пантелику. -->
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResult}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Style="{StaticResource StatBlockStyle}">
                            <TextBlock Style="{StaticResource StatValueStyle}"
                                       Text="{Binding ResultElapsedDisplay}" />
                            <TextBlock Style="{StaticResource StatCaptionStyle}"
                                       Text="{StaticResource Str_ResultTime}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatBlockStyle}">
                            <TextBlock Style="{StaticResource StatValueStyle}"
                                       Text="{Binding WordsPerMinute, StringFormat={}{0:N0}}" />
                            <TextBlock Style="{StaticResource StatCaptionStyle}"
                                       Text="{StaticResource Str_ResultWpm}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatBlockStyle}">
                            <TextBlock Style="{StaticResource StatValueStyle}"
                                       Text="{Binding CharsPerMinute, StringFormat={}{0:N0}}" />
                            <TextBlock Style="{StaticResource StatCaptionStyle}"
                                       Text="{StaticResource Str_ResultCpm}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{StaticResource Str_HotkeyHint}"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
