# Нормалізація переносів рядків.
# Репозиторій змішаний: Windows-проєкт (CRLF) і Gradle-проєкт (LF).
# text=auto — git зберігає все з LF, а на диску віддає у звичному для ОС вигляді.
* text=auto

# Явно LF — ці файли ламаються при CRLF
*.sh        text eol=lf
gradlew     text eol=lf
*.gradle    text eol=lf
*.kts       text eol=lf
*.properties text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Явно CRLF — інструменти Windows очікують саме його
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.vcxproj   text eol=crlf

# Текст і код (нормалізуються автоматично)
*.cs        text diff=csharp
*.xaml      text
*.kt        text
*.java      text
*.xml       text
*.json      text
*.md        text
*.txt       text
*.csv       text

# Бінарні — git не чіпає й не намагається робити diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.jar       binary
*.exe       binary
*.dll       binary
*.apk       binary
*.aab       binary
*.jks       binary
*.keystore  binary
*.ttf       binary
*.otf       binary
*.wav       binary
*.mp3       binary
